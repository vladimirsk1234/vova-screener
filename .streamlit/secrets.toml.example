# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Community Cloud → Settings → Secrets.
# Points Streamlit scans at NestJS + Mongo on the home PC (via local URL or Cloudflare Tunnel).

VOVA_API_URL = "http://127.0.0.1:3001/api"

# From Streamlit Cloud / phone-independent UI, use the tunnel hostname instead:
# VOVA_API_URL = "https://YOUR-SUBDOMAIN.trycloudflare.com/api"
# or named: "https://screener.example.com/api"
