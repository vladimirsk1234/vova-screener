{
  "name": "vova-screener",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @vova/api",
    "dev:web": "npm run dev -w @vova/web",
    "build:web": "npm run build -w @vova/web",
    "start": "npm run start -w @vova/api",
    "home-server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-server/start-home-server.ps1",
    "home-server:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-server/stop-home-server.ps1",
    "home-server:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-server/verify-home-server.ps1 -StartScanSmoke",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-server/start-tunnel.ps1 -Quick",
    "parity": "npm run parity -w @vova/engine",
    "typecheck": "npm run typecheck -w @vova/engine && npm run typecheck -w @vova/api && npm run typecheck -w @vova/web",
    "smoke:tracker": "npm run smoke:tracker -w @vova/api",
    "smoke:age": "npm run smoke:age -w @vova/api",
    "smoke:legacy": "npm run smoke:legacy -w @vova/api",
    "smoke:close-live": "npm run smoke:close-live -w @vova/api",
    "test:e2e": "npm run test:e2e -w @vova/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
