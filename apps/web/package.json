{
  "name": "@vova/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test src/lib/priceScaleFloor.test.ts src/lib/manualSearchHistory.test.ts src/lib/format.test.ts src/lib/apiError.test.ts src/lib/fundamentalsRefresh.test.ts src/lib/timeframes.test.ts src/lib/historyEpsEnrich.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@vova/engine": "*",
    "lightweight-charts": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.9.2",
    "vite": "^7.0.0"
  }
}
