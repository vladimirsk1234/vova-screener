{
  "name": "@vova/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "start": "node -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "smoke:tracker": "node -r ts-node/register -r tsconfig-paths/register src/dev/tracker-smoke.ts",
    "smoke:age": "node -r ts-node/register -r tsconfig-paths/register src/dev/signal-age-smoke.ts",
    "smoke:legacy": "node -r ts-node/register -r tsconfig-paths/register src/dev/legacy-import-smoke.ts",
    "smoke:close-live": "node -r ts-node/register -r tsconfig-paths/register src/dev/close-scan-live-smoke.ts",
    "smoke:delisted": "node -r ts-node/register -r tsconfig-paths/register src/dev/delisted-purge-smoke.ts",
    "smoke:normalize": "node -r ts-node/register -r tsconfig-paths/register src/dev/normalize-symbols-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test:period": "node --experimental-strip-types --test src/scans/period.test.ts src/instruments/fundamentals-catchup.test.ts src/instruments/card-premia.test.ts src/market/fmpSymbol.test.ts src/market/fmp.client.test.ts src/tracking/uv-sort.test.ts src/tracking/tf.test.ts src/tracking/peak-capital.test.ts src/tracking/benchmark.test.ts src/tracking/entry-premium.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@types/node": "^22.10.0",
    "@vova/engine": "*",
    "mongoose": "^8.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "mongodb-memory-server": "^10.1.4"
  }
}
